# Copy to .env (which is git-ignored) and fill in real values.
# Rotate any key that has been shared in chat, logs, or screenshots.

ANTHROPIC_API_KEY=sk-ant-...your-key...

GEMINI_API_KEY=sk-gemini-...your-key...

# Optional: override the Whisper model used by the ingest service (default: base)
# LATENTFRAME_WHISPER_MODEL=base
